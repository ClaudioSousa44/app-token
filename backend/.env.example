PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_token
DATABASE_SSL=false
FRONTEND_URL=http://localhost:4200

# Troque por valores longos e aleatorios antes de usar em producao.
JWT_ACCESS_SECRET=troque_este_secret_access_com_64_chars_ou_mais
JWT_REFRESH_SECRET=troque_este_secret_refresh_com_64_chars_ou_mais
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=12

